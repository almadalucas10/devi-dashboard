{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devi-dashboard-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "r2_buckets": [
    { "binding": "CACHE_BUCKET", "bucket_name": "devi-dashboard-cache" }
  ],

  "d1_databases": [
    { "binding": "QUALIDADE_DB", "database_name": "devi-dashboard-qualidade",
      "database_id": "677111a8-4f42-4f1f-be22-dd1a58fab393", "migrations_dir": "migrations" }
  ],

  "vars": {
    "OMIE_BASE_URL": "https://app.omie.com.br/api/v1",
    "SPREADSHEET_ID": "1ZMvgDkPCU3CMpeS4R0A26xFJQGHJhBAXOTBi73NKs4o",
    "INDICADORES_SPREADSHEET_ID": "1i3pAfBVle5Lj4pjvPikagdKhXeAwZAlalxPTcyDHuYI",
    "POP_FOLDER_ID": "1mg6CAvVAwO-QbpM7Oyp0DcCoQUrIuUVk",
    "SKIP_SHEETS_MIRROR": "false"
  },

  "triggers": {
    "crons": ["7,37 * * * *"]
  }
}
